service vendor.sensors.qti /vendor/bin/sensors.qti
    class core
    user system
    group system
    disabled

service vendor.sensor-sh /vendor/bin/init.qcom.sensors.sh
    class core
    user root
    oneshot

on property:ro.boot.hardware.sku=XT1922-2
    setprop persist.vendor.audio.fluence.speaker false
    setprop ro.boot.product.hardware.sku n
    setprop ro.opengles.version 196610
    setprop ro.sys.fw.dex2oat_thread_count 8

on property:ro.boot.hardware.sku=XT1922-3
    setprop persist.vendor.audio.fluence.speaker false
    setprop ro.opengles.version 196610
    setprop ro.sys.fw.dex2oat_thread_count 8

