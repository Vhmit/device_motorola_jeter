allow vendor_qti_init_shell kmsg_device:chr_file { open write };
dontaudit vendor_qti_init_shell self:capability { dac_override dac_read_search };
dontaudit vendor_qti_init_shell sysfs:file { write };
allow vendor_qti_init_shell ctl_start_prop:property_service set;
allow vendor_qti_init_shell ctl_stop_prop:property_service set;
